{
  "name": "prezograph",
  "version": "0.1.0",
  "description": "Open-source graph-based presentations from versioned JSON, with browser editing, CLI validation, and offline export.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yoheinakajima/prezograph.git"
  },
  "keywords": [
    "presentation",
    "graph",
    "json",
    "slides",
    "storytelling"
  ],
  "files": [
    "cli",
    "schemas",
    "src",
    "skills",
    "agent-instructions.md",
    "index.html",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "prezograph": "./cli/prezograph.mjs"
  },
  "scripts": {
    "build": "node scripts/build-single.mjs",
    "build:site": "node scripts/build-pages.mjs",
    "migrate": "node scripts/migrate-legacy.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "node --test",
    "check": "npm run validate && npm test && npm run build && npm run build:site",
    "validate": "node cli/prezograph.mjs validate examples/graphs-are-awesome/deck.json"
  },
  "engines": {
    "node": ">=20"
  }
}
